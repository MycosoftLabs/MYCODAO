# Server credentials. Set three distinct randomly generated secrets >=32 characters.
TOKENIZATION_ADMIN_KEY=
TOKENIZATION_REVIEWER_KEY=
SPECIES_TOKEN_PROXY_KEY=
TOKENIZATION_CLUSTER=devnet
TOKENIZATION_RPC_URL=https://api.devnet.solana.com
TOKENIZATION_DATABASE_PATH=./data/species-devnet.sqlite
TOKENIZATION_HOST=127.0.0.1
TOKENIZATION_PORT=8095

# Choose one signer. A devnet-only test keypair file may be configured locally.
TOKENIZATION_LOCAL_KEYPAIR_PATH=
# Mainnet requires an independent HTTPS policy signer; no key is copied to this service.
TOKENIZATION_SIGNER_URL=
TOKENIZATION_SIGNER_PUBLIC_KEY=
TOKENIZATION_SIGNER_AUTH_TOKEN=
TOKENIZATION_SIGNER_ALLOWED_ORIGINS=
TOKENIZATION_DISTRIBUTION_WALLET=
TOKENIZATION_ALLOW_MAINNET_BROADCAST=false
# Localnet requires its actual genesis hash; devnet/mainnet are pinned by the driver.
TOKENIZATION_GENESIS_HASH=

# Server-only MINDEX access. Exactly one MINDEX credential, never a browser credential.
TOKENIZATION_MINDEX_BASE_URL=
TOKENIZATION_MINDEX_API_KEY=
TOKENIZATION_MINDEX_INTERNAL_TOKEN=
TOKENIZATION_DATA_LICENSE_ID=
TOKENIZATION_MINDEX_SYNC_INTERVAL_MS=21600000

# Public HTTPS route must reach this service's /v1/metadata/<sha256> endpoint.
# Only licensed, attributed images permit automatic metadata publication.
TOKENIZATION_METADATA_PUBLIC_BASE=
TOKENIZATION_METADATA_ALLOWED_ORIGINS=
TOKENIZATION_MARKET_DATA_ENABLED=true

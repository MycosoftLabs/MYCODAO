{
  "name": "@mycodao/species-tokenization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker-main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "ops": "node --env-file-if-exists=.env --import tsx scripts/ops.ts"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.1.0",
    "@solana/spl-token": "0.4.14",
    "@solana/spl-token-metadata": "0.1.6",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
